# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/launch.json
.idea/
.claude/
.vercel

# Secrets : tous les .env, sauf les modèles qui documentent les variables.
.env*
!.env.example

# SSH deploy key material — never belongs in the repo, even generated locally.
deploy_key
deploy_key.pub

# Certificat d'origine Cloudflare et sauvegardes de config faites sur le VPS.
*.pem
*.key
*.bak

# Dependances du service de contact (deploye separement sur le VPS)
server/**/node_modules
server/**/.env
