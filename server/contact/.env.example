# ---------------------------------------------------------------------------
# SMTP — compte utilisé pour AUTHENTIFIER l'envoi.
# ---------------------------------------------------------------------------
# Il faut une vraie boîte avec un mot de passe. Une redirection OVH n'en est
# pas une : elle n'a ni compte ni identifiants, donc rien avec quoi se
# connecter. Deux options, voir README.md pour le détail.
#
#   A. Boîte OVH sur le domaine (nécessite une offre MX Plan avec comptes) :
#        SMTP_HOST=ssl0.ovh.net
#        SMTP_PORT=465
#        SMTP_USER=contact@valentincombier.com
#
#   B. Gmail avec un mot de passe d'application (gratuit, 2FA requise) :
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=465
#        SMTP_USER=<ton-adresse>@gmail.com
#
# L'expéditeur du mail est SMTP_USER. Ne mets pas une adresse du domaine ici
# si tu envoies via Gmail : le SPF de valentincombier.com est en `-all` et
# n'autorise qu'OVH, le message partirait en indésirables.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Destinataire des messages du formulaire. Peut être une redirection OVH
# (contact@valentincombier.com) ou n'importe quelle adresse à toi.
CONTACT_TO=

# Port d'écoute local — nginx proxifie dessus, jamais exposé directement.
PORT=8081
